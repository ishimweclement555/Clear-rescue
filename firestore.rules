rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Direct check for admin email or admin document
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ishimweclement537@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Health probe doc for skill validation
    match /test/connection {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Devices collection
    match /devices/{deviceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Sensors collection
    match /sensors/{sensorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Sensor readings collection (telemetry)
    match /sensor_readings/{readingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Incidents collection
    match /incidents/{incidentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Maintenance records
    match /maintenance_records/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // immutable audit log
    }

    // System settings
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
